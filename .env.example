# ============================================================================
# lorag — .env 配置模板
# 拷贝为 .env 后按需修改。lorag 启动时自动加载。
# 也可由 LORAG_ENV 环境变量指向其他 .env 文件路径。
# ============================================================================

# ----- 模型仓库 -----
# lorag 通过 aha crate 调用模型（aha = { path = "..." }）。
# 模型 id 必须是 aha WhichModel 接受的字符串。
# 完整支持列表（aha 官方）：https://github.com/jhqxxx/aha/blob/main/docs/supported-models.zh-CN.md
#
# 推荐起步（4B LLM + 0.6B Embedding，性价比最优点，CUDA 1-3s/query）：
#   - 0.6B 起步也是 OK 的（个人 demo / 简单问答），但质量天花板低
#   - 4B LLM 推荐带 CUDA 跑（cargo build --features aha/cuda），CPU 跑 15-30s/query
#   - 想加 Rerank 再 append 一个 Qwen3-Reranker-0.6B（aha 原生支持）
LLM_MODEL=Qwen/Qwen3-4B
EMBED_MODEL=Qwen/Qwen3-Embedding-0.6B
# 可选：Rerank 模型。**留空 = 禁用 rerank**（省 ~1.5GB 内存 + 数十秒 load）。
# 启用时第一次 query 会懒加载。aha 支持 Qwen3-Reranker-0.6B / 4B / 8B。
# RERANK_MODEL=Qwen/Qwen3-Reranker-0.6B

# ----- 模型下载位置 -----
# `lorag models pull` 调 aha crate 的 download_model，把模型下到
# <MODELS_DIR>/<MODEL>/ 下面（与 aha lib 期望的目录结构一致）。
# 例如：./data/models/Qwen/Qwen3-4B/  (safetensors 文件就在这一层)
# Windows 示例：D:\workspace\rust\lorag\data\models
# Unix 示例：./data/models 或 /opt/lorag/models
MODELS_DIR=./data/models

# 下载重试次数（aha::utils::download_model 的 max_retries 参数）
DOWNLOAD_MAX_RETRIES=3

# ----- 向量维度 -----
# **不用配**。lorag 启动时从 embedding 模型的 config.json::hidden_size 自动读出来。
# lancedb schema 跟模型走；改 EMBED_MODEL 后**清掉数据库重建**：
#   rm -rf data/lancedb data/lorag.db
# 两个都要删：
#   - lancedb：向量维度硬编码在 schema，不删就 schema 不匹配
#   - sqlite：chunks 表的 UNIQUE(source_id, chunk_ordinal) 约束会让重 ingest 撞唯一索引
# 然后重新 `lorag ingest <path>`。

# ----- 数据库路径 -----
LANCEDB_DIR=./data/lancedb
SQLITE_PATH=./data/lorag.db

# ----- 文本切分 -----
# 超过 CHUNK_SIZE 字符的段落会按窗口再切，重叠 CHUNK_OVERLAP 字符
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# ----- 检索 -----
TOP_K=5
# Rerank 粗筛条数（仅在配了 RERANK_MODEL 时生效；vector_search 先取 top-RERANK_TOP_N
# 再 rerank 排序取 final top_k）。默认 50，**必须** > TOP_K。
# 调大 → 召回更宽但 rerank 更慢 + 费 CPU/内存；调小 → 更快但召回更窄。
# CLI 可临时覆盖：--rerank-top-n <N>。
RERANK_TOP_N=50

# ----- 日志 -----
# tracing 日志级别，如 info / debug / warn / error
# 也可用逗号分隔多个 crate：info,lance=error 可屏蔽 lance 的 deprecation warning
# 如果同时设了 RUST_LOG 环境变量，RUST_LOG 优先
LOG_LEVEL=info

# ----- 提示词（可覆盖内置默认值）-----
# 留空则使用 lorag 内置默认值。默认值已内置 5 条防注入铁律（不可被用户输入覆盖）。
# PROMPT_SYSTEM_ROLE: RAG 助手的系统角色描述（最高优先级规则在此）
# PROMPT_RAG_INSTRUCTION: query 模式下告诉 LLM 如何使用【上下文】
# PROMPT_CHAT_CONTEXT_INSTRUCTION: chat 多轮时指代【文档上下文】的指令
# PROMPT_BARE_LLM: 无 RAG 上下文 fallback 时的简洁提示词
# 示例：
# PROMPT_SYSTEM_ROLE=你是 lorag 本地 RAG 助手。以下规则具有最高优先级...
# PROMPT_RAG_INSTRUCTION=仅根据下面的【上下文】中的文档内容回答问题。
# PROMPT_CHAT_CONTEXT_INSTRUCTION=仅根据上面的【文档上下文】中的文档内容回答【当前问题】
# PROMPT_BARE_LLM=你是一个简洁的助手，用一两句话直接回答问题。
