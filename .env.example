# ============================================================================
# lorag — .env 配置模板
# 拷贝为 .env 后按需修改。lorag 启动时自动加载。
# 也可由 LORAG_ENV 环境变量指向其他 .env 文件路径。
# ============================================================================

# ----- 模型仓库 -----
# lorag 通过 aha crate 调用模型（aha = { path = "..." }）。
# 模型 id 必须是 aha WhichModel 接受的字符串（见 aha::models::common::model_mapping）。
# aha 官方支持的 LLM：Qwen/Qwen3-{0.6B,1.7B,4B} / Qwen/Qwen3.5-{0.8B,2B,4B,9B} /
#                      OpenBMB/MiniCPM{4-0.5B,5-1B} / LiquidAI/LFM{2-1.2B,2.5-1.2B-Instruct}
# aha 官方支持的 Embedding：
#   - sentence-transformers/all-MiniLM-L6-v2 → 384 维
#   - Qwen/Qwen3-Embedding-0.6B              → 1024 维
#   - Qwen/Qwen3-Embedding-4B                → 2560 维
#   - Qwen/Qwen3-Embedding-8B                → 4096 维
LLM_MODEL_REPO=Qwen/Qwen3-4B
EMBED_MODEL_REPO=sentence-transformers/all-MiniLM-L6-v2

# ----- 调 aha 时 JSON 的 model 字段值 -----
# 默认 = 上面 MODEL_REPO 的值，可以省略不写（lorag 启动时 fallback）。
# 当 aha 模型 id 和调用的 model 字段不一致时才需要显式改。
LLM_MODEL_NAME=Qwen/Qwen3-4B
EMBED_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# ----- 模型下载位置 -----
# `lorag models pull` 调 aha crate 的 download_model，把模型下到
# <MODELS_DIR>/<MODEL_REPO>/ 下面（与 aha lib 期望的目录结构一致）。
# 例如：./data/models/Qwen/Qwen3-4B/  (safetensors 文件就在这一层)
# Windows 示例：D:\workspace\rust\lorag\data\models
# Unix 示例：./data/models 或 /opt/lorag/models
MODELS_DIR=./data/models

# 下载重试次数（aha::utils::download_model 的 max_retries 参数）
DOWNLOAD_MAX_RETRIES=3

# ----- 向量维度 -----
# 跟你的 embedding 模型输出维度必须一致！
#   sentence-transformers/all-MiniLM-L6-v2 = 384
#   Qwen/Qwen3-Embedding-0.6B              = 1024
#   Qwen/Qwen3-Embedding-4B                = 2560
#   Qwen/Qwen3-Embedding-8B                = 4096
# 改了之后必须 rm -rf data/lancedb 再 ingest
EMBED_DIM=384

# ----- 数据库路径 -----
LANCEDB_DIR=./data/lancedb
SQLITE_PATH=./data/lorag.db

# ----- 文本切分 -----
# 超过 CHUNK_SIZE 字符的段落会按窗口再切，重叠 CHUNK_OVERLAP 字符
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# ----- 检索 -----
TOP_K=5

# ----- 日志 -----
# tracing 日志级别，如 info / debug / warn / error
# 也可用逗号分隔多个 crate：info,lance=error 可屏蔽 lance 的 deprecation warning
# 如果同时设了 RUST_LOG 环境变量，RUST_LOG 优先
LOG_LEVEL=info
